# Copy this file to .env in backend/ before running the backend.
# Replace all development credentials before deploying anywhere public.
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./shopsphere.db
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_EMAIL=admin@shopsphere.io
DEFAULT_ADMIN_PASSWORD=replace-this-admin-password

# Cashfree (optional for local COD-only testing)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01

# Cloudinary image uploads (optional if not testing uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ShopSphere Admin AI Analyst. Leave AI_API_KEY blank to use safe rule-based
# analytics only. For Groq, create an API key in the Groq console and paste it
# here; never expose this key in the React frontend or commit this file.
AI_PROVIDER=groq
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_REQUEST_TIMEOUT_SECONDS=45
